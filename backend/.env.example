# Set these only in Render environment variables. Never commit real values.
INSTAGRAM_ACCESS_TOKEN=replace_with_server_side_secret
ALLOWED_INSTAGRAM_ACCOUNT_ID=replace_with_authorized_account_id

# For Instagram API with Instagram Login (the setup shown in your Meta dashboard):
META_API_HOST=https://graph.instagram.com

# For an app intentionally using Instagram API with Facebook Login:
# META_API_HOST=https://graph.facebook.com

META_GRAPH_VERSION=v23.0
PORT=3000
